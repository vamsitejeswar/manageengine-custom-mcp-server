# ManageEngine Endpoint Central base URL (no trailing slash)
ME_BASE_URL=https://your-endpoint-central-server.com

# IAM name prefix used in OAuth scope strings (default: AaaServer)
IAM_NAME=AaaServer

# Custom report view name (used for POST /{crview}.ec endpoint)
CRVIEW=CustomReportView

# HTTP server settings
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ─── Gemini OAuth Form Values ─────────────────────────────────────────────────
# MCP Server URL     : https://<your-domain>:<PORT>
# Authorization URL  : https://accounts.zoho.com/oauth/v2/auth
# Auth URL Params    : access_type=offline&prompt=consent
# Token URL          : https://accounts.zoho.com/oauth/v2/token
# Client ID          : <your Zoho API Client ID>
# Client Secret      : <your Zoho API Client Secret>
# Scopes (space-sep) : AaaServer.PatchMgmt.READ AaaServer.PatchMgmt.UPDATE
#                      AaaServer.VulnerabilityMgmt.READ AaaServer.DeviceControl.READ
#                      AaaServer.Inventory.READ AaaServer.CustomField.READ
#                      AaaServer.CustomField.CREATE AaaServer.CustomField.UPDATE
#                      AaaServer.CustomField.DELETE AaaServer.SOM.READ
#                      AaaServer.SOM.UPDATE AaaServer.QueryReport.READ
#                      AaaServer.CustomReport.READ AaaServer.DEX.READ
#                      AaaServer.DataEncryption.READ AaaServer.EndpointDLP.READ
#                      AaaServer.Common.READ
# Enable PKCE        : checked (recommended)
